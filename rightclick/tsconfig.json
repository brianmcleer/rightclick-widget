{
  // Visual Studio / VS Code editor support only (mode B, self-contained).
  // ts-loader DOES read this file when webpack builds the widget, so jsx and
  // jsxImportSource must match client\tsconfig.json. Everything else is editor-only.
  //
  // Why self-contained: on this EB 1.21 (pnpm) install Visual Studio cannot
  // read client\node_modules (IDE1100 "Access to the path is denied" on the
  // pnpm junctions). So: no "paths", no "baseUrl", "types": [] and every
  // module the widget imports is declared ambiently in
  // src/exb-editor-shims.d.ts (copied unchanged from widgets\_vs) plus the
  // widget-specific src/vendor-shims.d.ts. jsx is "react-jsx" + "@emotion/react" and must never change (see 12.3;
  // ts-loader reads this file, classic jsx crashes the widget at runtime). Verify with `npx tsc -p .` from this folder (0 errors expected).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "types": [],
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "isolatedModules": false,
    "forceConsistentCasingInFileNames": false
  },
  "include": [ "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts" ],
  "exclude": [ "node_modules", "dist" ]
}
