{
  // Visual Studio / VS Code editor support only (mode B, self-contained).
  // The Experience Builder webpack build uses client\tsconfig.json and never
  // reads this file. noEmit keeps it inert.
  //
  // Why self-contained: on this EB 1.21 (pnpm) install Visual Studio cannot
  // read client\node_modules (IDE1100 "Access to the path is denied" on the
  // pnpm junctions). So: no "paths", no "baseUrl", "types": [] and every
  // module the widget imports is declared ambiently in
  // src/exb-editor-shims.d.ts (copied unchanged from widgets\_vs) plus the
  // widget-specific src/vendor-shims.d.ts. Classic "jsx": "react" never
  // resolves a jsx-runtime module, so the denied @types\react file is never
  // opened. Verify with `npx tsc -p .` from this folder (0 errors expected).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "types": [],
    "jsx": "react",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "isolatedModules": false,
    "forceConsistentCasingInFileNames": false
  },
  "include": [ "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts" ],
  "exclude": [ "node_modules", "dist" ]
}
